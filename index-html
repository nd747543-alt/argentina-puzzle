<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>Argentina Puzzle - English</title>
<style>
*{box-sizing:border-box} body{margin:0;font-family:system-ui,-apple-system,Segoe UI,sans-serif;background:linear-gradient(145deg,#d9f3ff,#fff);color:#123}
.wrap{max-width:520px;margin:auto;padding:16px}.hero{background:#fff;border-radius:22px;padding:18px;box-shadow:0 8px 28px #0001}
h1{margin:0 0 4px;text-align:center;font-size:27px}.sub{text-align:center;margin:0 0 15px;color:#456}
.photo{position:relative;width:100%;aspect-ratio:3/2;border-radius:16px;overflow:hidden;background:#bde7f7 center/cover no-repeat;
background-image:url("https://commons.wikimedia.org/wiki/Special:Redirect/file/Argentina%20Starting%20XI%20Argentina%20v%20Egypt%207%20July%202026-118.jpg");}
#pieces{position:absolute;inset:0;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(3,1fr)}
.piece{border:1px solid #ffffffaa;background:rgba(255,255,255,.92);display:flex;align-items:center;justify-content:center;font-weight:800;color:#356;transition:.25s}
.piece.done{background:transparent;color:transparent;border-color:#fff5}
.controls{margin-top:14px;text-align:center}.progress{font-weight:800;margin-bottom:9px}
button{border:0;border-radius:13px;padding:12px 18px;background:#75bddd;color:#062b3c;font-weight:800;font-size:16px}
.card{margin-top:14px;background:#f8fcff;border:1px solid #d4edf8;border-radius:17px;padding:15px}
.q{font-size:19px;font-weight:800;margin:0 0 12px}.answers{display:grid;gap:9px}
.answer{width:100%;background:white;border:2px solid #c8e6f2;color:#163b4b;text-align:left}
.answer:disabled{opacity:.65}.feedback{min-height:24px;margin-top:11px;font-weight:700}
.study{display:none;margin-top:12px;background:#eef9ff;border-radius:12px;padding:10px}.study.show{display:block}
small{color:#567}
</style>
</head>
<body>
<div class="wrap"><div class="hero">
<h1>🇦🇷 Argentina Puzzle</h1>
<p class="sub">Answer in English and complete the team!</p>
<div class="photo"><div id="pieces"></div></div>
<div class="controls"><div class="progress" id="progress">Pieces: 0 / 9</div></div>
<div class="card">
<p class="q" id="question"></p>
<div class="answers" id="answers"></div>
<div class="feedback" id="feedback"></div>
<div class="study" id="study"></div>
</div>
</div></div>
<script>
const qs=[
["Who is the famous number 10 of Argentina?","Lionel Messi",["Lionel Messi","Emiliano Martínez","Julián Álvarez"]],
["What are Argentina's team colors?","Light blue and white",["Red and black","Light blue and white","Green and yellow"]],
["How many stars are on Argentina's badge?","Three",["One","Two","Three"]],
["What sport does Argentina play?","Football",["Basketball","Football","Tennis"]],
["Who is Argentina's head coach?","Lionel Scaloni",["Lionel Scaloni","Pep Guardiola","José Mourinho"]],
["What is Argentina's nickname?","La Albiceleste",["La Albiceleste","The Reds","The Blues"]],
["Which continent is Argentina in?","South America",["Europe","South America","Asia"]],
["What trophy did Argentina win in 2022?","The FIFA World Cup",["The FIFA World Cup","The Champions League","The Copa del Rey"]],
["What language is mainly spoken in Argentina?","Spanish",["English","Portuguese","Spanish"]]
];
let i=0,done=0;
const pieces=document.getElementById("pieces");
qs.forEach((_,n)=>{let d=document.createElement("div");d.className="piece";d.id="p"+n;d.textContent=n+1;pieces.appendChild(d)});
function render(){
 if(i>=qs.length){document.getElementById("question").textContent="🎉 Congratulations! You completed the puzzle!";document.getElementById("answers").innerHTML="";document.getElementById("feedback").textContent="Great job!";document.getElementById("study").classList.add("show");document.getElementById("study").innerHTML="🇪🇸 ¡Completaste el rompecabezas!";return}
 const [q,a,opts]=qs[i];document.getElementById("question").textContent=q;
 const box=document.getElementById("answers");box.innerHTML="";
 document.getElementById("feedback").textContent="";document.getElementById("study").classList.remove("show");
 opts.forEach(x=>{let b=document.createElement("button");b.className="answer";b.textContent=x;b.onclick=()=>answer(x);box.appendChild(b)});
}
function answer(x){
 const [q,a]=qs[i];const f=document.getElementById("feedback");const s=document.getElementById("study");
 if(x===a){document.getElementById("p"+i).classList.add("done");done++;document.getElementById("progress").textContent=`Pieces: ${done} / 9`;f.textContent="✅ Correct! Piece unlocked.";s.classList.add("show");s.innerHTML=`🇪🇸 <b>Respuesta:</b> ${a}`;[...document.querySelectorAll(".answer")].forEach(b=>b.disabled=true);setTimeout(()=>{i++;render()},900)}
 else{f.textContent="❌ Try again! / ¡Intentá de nuevo!";s.classList.add("show");s.innerHTML=`🇪🇸 <b>Pista:</b> Pensá en la pregunta y elegí otra opción.`}
}
render();
</script>
</body>
</html>
